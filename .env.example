# ─────────────────────────────────────────────────────────────
# Koda Running Coach — variables de entorno
# Copia este archivo a .env y rellena los valores.
# ⚠️ .env NUNCA se sube al repo. Está en .gitignore.
# ─────────────────────────────────────────────────────────────

# --- Aplicación ---
APP_ENV=development                  # development | production
APP_BASE_URL=http://localhost:8000   # se usa para construir los enlaces mágicos
LOG_LEVEL=INFO

# --- Seguridad ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRE_DAYS=30
MAGIC_LINK_TTL_MINUTES=15

# --- Selección de proveedor (el plan B se activa aquí) ---
# aws | fallback     ← ver docs/contexto/00-CONTEXTO.md
PROVIDER_STT=aws
PROVIDER_LLM=aws
PROVIDER_TTS=aws
PROVIDER_EMAIL=aws

# --- AWS ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock — el id exacto lo confirmas en la consola, region us-east-1
BEDROCK_MODEL_ID=
BEDROCK_MODEL_ID_BARATO=             # modelo pequeño para extracción de memoria
BEDROCK_MAX_TOOL_ITERATIONS=3

# Transcribe
TRANSCRIBE_LANGUAGE=es-MX

# Polly
POLLY_VOICE_ID=Mia
POLLY_ENGINE=generative              # generative | neural | standard
POLLY_OUTPUT_FORMAT=mp3

# SES — el remitente debe estar verificado en la consola de SES
SES_FROM_EMAIL=koda@tudominio.com
SES_FROM_NAME=Koda
SES_CONFIGURATION_SET=               # opcional: para registrar rebotes y quejas

# S3 — almacenamiento de audio e imágenes
S3_BUCKET=
S3_SIGNED_URL_TTL_SECONDS=600

# --- Plan B (solo si PROVIDER_* = fallback) ---
GROQ_API_KEY=
GEMINI_API_KEY=
RESEND_API_KEY=

# --- Base de datos ---
DATABASE_URL=postgresql+asyncpg://koda:koda@localhost:5432/koda

# --- Límites (ver docs/contexto/04-ENTRADAS-MULTIMODALES.md) ---
MAX_AUDIO_SECONDS=60
MAX_AUDIO_MB=10
MAX_TEXT_CHARS=2000
MAX_IMAGES_PER_MESSAGE=3
MAX_IMAGE_MB=8
MAX_VIDEO_SECONDS=10
MAX_VIDEO_MB=25
VIDEO_KEYFRAMES=6
RATE_LIMIT_MESSAGES_PER_HOUR=30
RATE_LIMIT_MAGIC_LINKS_PER_HOUR=5

# --- Recordatorios ---
REMINDER_MORNING_HOUR=6              # hora LOCAL del runner, no UTC
REMINDER_EVENING_HOUR=20
REMINDER_WEEKLY_DAY=6                # 0=lunes ... 6=domingo
REMINDER_WEEKLY_HOUR=19
REMINDER_INACTIVE_DAYS=30            # deja de enviar tras este tiempo sin uso
